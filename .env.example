# Copy to .env (never commit it). Used by docker-compose.yml and the Django container.

# Django
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
# Add the server's LAN IP to reach the API on BACKEND_PORT directly
ALLOWED_HOSTS=api.danielloftus.dev,localhost,127.0.0.1

# Postgres
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=change-me

# Media folder on the host (the old S3 contents: projects/..., resume/...)
MEDIA_PATH=/srv/portfolio/media
MEDIA_BASE_URL=https://danielloftus.dev/media/

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
CLOUDFLARE_TUNNEL_TOKEN=

# Host ports for LAN access; change if they clash with your other containers
FRONTEND_PORT=8080
BACKEND_PORT=8001
